{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ofg:ea:OFG-EA-HANDOFF-V1",
  "title": "OFG-EA-HANDOFF-V1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "OFG-EA-HANDOFF-V1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "source_thread": {
      "enum": [
        "T1-G2",
        "T2-G2",
        "T4-G2",
        "T5-G2"
      ]
    },
    "logical_thread": {
      "enum": [
        1,
        2,
        4,
        5
      ]
    },
    "master_epoch": {
      "const": 2
    },
    "source_workstream_profile": {
      "enum": [
        "MOBILE_IPHONE",
        "DESKTOP_FULL"
      ]
    },
    "target_workstream_profile": {
      "enum": [
        "MOBILE_IPHONE",
        "DESKTOP_FULL"
      ]
    },
    "repository": {
      "const": "Taro102/OFG-Engineering-Atlas"
    },
    "branch": {
      "const": "main"
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "state_root_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "active_cycle": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_state": {
      "type": "object"
    },
    "completed_work": {
      "type": "array"
    },
    "pending_work": {
      "type": "array"
    },
    "relevant_sources": {
      "type": "array"
    },
    "identities_touched": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "open_items": {
      "type": "array"
    },
    "provenance_updates": {
      "type": "array"
    },
    "V&V_state": {
      "type": "object"
    },
    "cross_thread_dependencies": {
      "type": "array"
    },
    "read_set": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:ofg:ea:OFG-EA-ACCESS-V1",
        "title": "OFG-EA-ACCESS-V1",
        "type": "object",
        "properties": {
          "schema": {
            "const": "OFG-EA-ACCESS-V1"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "record_selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "exists": {
            "type": "boolean"
          },
          "expected_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "const": "READ"
          }
        },
        "required": [
          "schema",
          "path",
          "record_selector",
          "exists",
          "expected_sha256",
          "operation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "exists": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "expected_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "exists": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "expected_sha256": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "write_set": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:ofg:ea:OFG-EA-ACCESS-V1",
        "title": "OFG-EA-ACCESS-V1",
        "type": "object",
        "properties": {
          "schema": {
            "const": "OFG-EA-ACCESS-V1"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "record_selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "exists": {
            "type": "boolean"
          },
          "expected_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "enum": [
              "ADD",
              "SUPERSEDE_POINTER",
              "APPEND_SEGMENT"
            ]
          }
        },
        "required": [
          "schema",
          "path",
          "record_selector",
          "exists",
          "expected_sha256",
          "operation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "exists": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "expected_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "exists": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "expected_sha256": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "expected_postcondition": {
      "type": "string",
      "minLength": 1
    },
    "resume_key": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_desktop_actions": {
      "type": "array"
    },
    "required_mobile_actions": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "handoff_id",
    "source_thread",
    "logical_thread",
    "master_epoch",
    "source_workstream_profile",
    "target_workstream_profile",
    "repository",
    "branch",
    "repository_head",
    "state_root_hash",
    "active_cycle",
    "task_id",
    "dispatch_id",
    "checkpoint_state",
    "completed_work",
    "pending_work",
    "relevant_sources",
    "identities_touched",
    "conflicts",
    "open_items",
    "provenance_updates",
    "V&V_state",
    "cross_thread_dependencies",
    "read_set",
    "write_set",
    "expected_postcondition",
    "resume_key",
    "payload_hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "target_workstream_profile": {
            "const": "DESKTOP_FULL"
          }
        }
      },
      "then": {
        "required": [
          "required_desktop_actions"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "target_workstream_profile": {
            "const": "MOBILE_IPHONE"
          }
        }
      },
      "then": {
        "required": [
          "required_mobile_actions"
        ]
      }
    }
  ],
  "$comment": "All semantic hashing uses control/workflow_protocol_v3.json#/serialization/canonical_contract; exact source bytes are never NFC-normalized."
}
