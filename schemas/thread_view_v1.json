            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "plane": {
            "enum": [
              "CONTROL",
              "EVIDENCE",
              "EVENT",
              "SEMANTIC_STATE",
              "INDEX",
              "EXECUTION"
            ]
          }
        },
