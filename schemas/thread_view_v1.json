        "minLength": 1
      }
    },
    "view_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "view_id",
    "state_root_hash",
    "repository_head",
    "physical_instance",
    "master_epoch",
    "scope",
    "read_set",
    "claim_refs",
