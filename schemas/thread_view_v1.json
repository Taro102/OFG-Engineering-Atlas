{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ofg:ea:OFG-EA-VIEW-V1",
  "title": "OFG-EA-VIEW-V1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "OFG-EA-VIEW-V1"
    },
    "view_id": {
      "type": "string",
      "minLength": 1
    },
    "state_root_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "physical_instance": {
      "enum": [
        "T1-G2",
        "T2-G2",
        "T4-G2",
        "T5-G2"
      ]
    },
    "master_epoch": {
      "const": 2
    },
    "scope": {
      "type": "object"
    },
    "read_set": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:ofg:ea:OFG-EA-ACCESS-V1",
        "title": "OFG-EA-ACCESS-V1",
        "type": "object",
        "properties": {
          "schema": {
            "const": "OFG-EA-ACCESS-V1"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "record_selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "exists": {
            "type": "boolean"
          },
          "expected_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation": {
            "const": "READ"
          }
        },
        "required": [
          "schema",
          "path",
          "record_selector",
          "exists",
          "expected_sha256",
          "operation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "exists": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "expected_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "exists": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "expected_sha256": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:ofg:ea:OFG-EA-OBJECT-REFERENCE-V1",
        "title": "OFG-EA-OBJECT-REFERENCE-V1",
        "type": "object",
        "properties": {
          "schema": {
            "const": "OFG-EA-OBJECT-REFERENCE-V1"
          },
          "repository": {
            "const": "Taro102/OFG-Engineering-Atlas"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "record_selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "plane": {
            "enum": [
              "CONTROL",
              "EVIDENCE",
              "EVENT",
              "SEMANTIC_STATE",
              "INDEX",
              "EXECUTION"
            ]
          }
        },
        "required": [
          "schema",
          "repository",
          "commit",
          "path",
          "record_selector",
          "sha256",
          "byte_count",
          "plane"
        ],
        "additionalProperties": false
      }
    },
